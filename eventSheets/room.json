			],
			"actions": [
				{
					"type": "comment",
					"text": "Вход в комнату. Ключ \"X,Y\"; новой комнате выбирается случайный шаблон камней и запоминается в словаре Rooms"
				},
				{
					"id": "set-eventvar-value",
					"objectClass": "System",
					"sid": 833320804632809,
					"parameters": {
						"variable": "RoomKey",
						"value": "RoomX & \",\" & RoomY"
					}
				},
				{
					"id": "set-eventvar-value",
					"objectClass": "System",
					"sid": 471888248856111,
					"parameters": {
						"variable": "NewRoom",
						"value": "(Rooms.Get(RoomKey) = 0) & ((RoomX <> 0) | (RoomY <> 0))"
					}
				},
				{
					"id": "add-key",
					"objectClass": "Rooms",
					"sid": 498466265590320,
					"parameters": {
						"key": "RoomKey",
						"value": "(Rooms.Get(RoomKey) > 0) ? Rooms.Get(RoomKey) : (((RoomX = 0) & (RoomY = 0)) ? 0 : floor(random(1, 7)))"
					}
				},
				{
					"id": "add-to-eventvar",
					"objectClass": "System",
					"sid": 429950790825940,
					"parameters": {
						"variable": "RoomsVisited",
						"value": "NewRoom"
					}
				},
				{
					"type": "comment",
					"text": "Игрок появляется у двери, противоположной той, через которую вышел"
				},
